# IMPORTANT:
#    Do not forget to keep SYNC .env and .env.example files.
#    Do not add ".env" file to git, it contains sensitive information.


# THE ENV VARIABLES BELOW ALSO DEFINE THE BRANCH IN GITEA, CHECK THE FILE
# "docs/GIT_STRATEGY.md" FOR MORE INFO.
MY_ENV=■■■                                                # local | stage | PROD

# Domain and  SSL              Local          Stage           PROD
MY_DOMAIN=■■■.■■■    # ■■■-local.com    ■■■-stage.com    ■■■.com
MY_USER=■■■
MY_PASS=■■■
MY_EMAIL=■■■

# Shared Secret, used in webhooks, token, etc.
SHARED_TOKEN=■■■

# CAUTION: Don't use UID or GID name variables because can be confused with
# the already defined by the system. I got the error "local: UID: readonly variable".
# when I used "UID=■■■".
MY_UID=■■■
# run "getent group docker | cut -d: -f3" to get the GID of docker group in your system.
DOCKER_GID=■■■

# DATABASE
DB_SCHEMA=■■■
DB_USER=■■■
DB_PASS=■■■
DB_SERVER=t51db
DB_VOLUME=t51DB_vol1 # It's also hardcoded in docker-compose.yml, in 'volumes:' section
DB_IP=172.30.0.101
DB_PORT=5001


# IMAGES
IMAGE_MVN=maven:3.10.0-eclipse-temurin-25-alpine
IMAGE_JENKINS=jenkins/jenkins:2.586-jdk25
IMAGE_T51JENKINS=t51-jenkins:latest
IMAGE_GITEA=gitea/gitea:28.2-rootless
IMAGE_JAVA=eclipse-temurin:25-jre-alpine-3.24
IMAGE_NODE=node:24.22.0-trixie-slim
IMAGE_NGINX=nginx:1.30.6-alpine3.24-slim
IMAGE_REVERSE_PROXY=nginxproxy/nginx-proxy:1.11.6-alpine
IMAGE_ACME_COMPANION=nginxproxy/acme-companion:2.8
IMAGE_HTTPD=httpd:2
IMAGE_NEXUS=sonatype/nexus3:3.96.4-alpine
IMAGE_CURL=curlimages/curl:8.23.0
IMAGE_T51DB_UTILS=db_utils:latest
IMAGE_DB=postgres:18.6-trixie
IMAGE_DB_MIG_BASE=liquibase:5.0.1-alpine
IMAGE_DB_MIG=base_db_utils:latest


# CONFIGURATION
# CAUTION
#
# 1. Before changing the variables "*_NAME" for example "DB_MIG_NAME", also
# change the name of the files in "setup/gitea/initial_repos/*.tar.xz". e.g.
# "BACK_NAME=t51back" and "setup/gitea/initial_repos/t51back.tar.xz" must match.

# Database Migrations
DB_MIG_NAME=t51mig-db
DB_MIG_REPO=ssh://git@gitea:2222/${MY_USER}/${DB_MIG_NAME}.git


# Back-end
BACK_NAME=t51back
BACK_REPO=ssh://git@gitea:2222/${MY_USER}/${BACK_NAME}.git
BACK_IMAGE=${BACK_NAME}:latest
BACK_IP=172.30.0.102
BACK_URL=http://api.${MY_DOMAIN}


# Front-end
FRONT_NAME=t51front
FRONT_REPO=ssh://git@gitea:2222/${MY_USER}/${FRONT_NAME}.git
FRONT_IMAGE=${FRONT_NAME}:latest
FRONT_IP=172.30.0.103
FRONT_PORT=80


# Dev-Ops
DEVOPS_NAME=t51devops
DEVOPS_REPO=ssh://git@gitea:2222/${MY_USER}/${DEVOPS_NAME}.git


GITEA_IP=172.30.0.201
GITEA_PORT=3000

JENKINS_IP=172.30.0.202
JENKINS_PORT=3001

REVERSE_PROXY_IP=172.30.0.203
ACME_COMPANION_IP=172.30.0.204
NEXUS_IP=172.30.0.215
NEXUS_HTTP_PORT=8081
NEXUS_REGISTRY_PORT=5000

BUILDX_BUILDER=t51-builder
NETWORK_NAME=t51Net

